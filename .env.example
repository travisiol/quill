# ---- site (Next.js) -------------------------------------------------------
# Upstream JSON-RPC used by /api/rpc when the manifest's rpcUrl is not local.
# Defaults to the manifest's rpcUrl, then to the public Robinhood Chain RPC.
# QUILL_RPC_UPSTREAM=https://rpc.mainnet.chain.robinhood.com

# Vercel Blob token: with it, the avatar "Upload" tab stores files on Blob.
# Without it, uploads land in public/uploads (local disk; read-only on Vercel).
# BLOB_READ_WRITE_TOKEN=

# ---- contracts (contracts/.env) -------------------------------------------
# DEPLOYER_PRIVATE_KEY=0x...          # pays the deployment and bootstraps the registry
# ADMIN=0x...                          # Ownable2Step owner of the four proxies (defaults to the deployer)
# TREASURY=0x...                       # receives withdrawRevenue() (defaults to the deployer)
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
